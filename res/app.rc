#include <winver.h>
1 ICON "tachyon.ico"
1 VERSIONINFO
FILEVERSION 1,0,1,0
PRODUCTVERSION 1,0,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904B0"
    BEGIN
      VALUE "CompanyName", "Formray"
      VALUE "FileDescription", "Tachyon - lightweight read-only NVIDIA GPU monitor"
      VALUE "FileVersion", "1.0.1.0"
      VALUE "InternalName", "tachyon"
      VALUE "LegalCopyright", "(c) 2026 Formray. MIT OR Apache-2.0"
      VALUE "OriginalFilename", "tachyon.exe"
      VALUE "ProductName", "Tachyon"
      VALUE "ProductVersion", "1.0.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x809, 1200
  END
END
