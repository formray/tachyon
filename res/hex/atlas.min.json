00, 0, 1); A = mix(#4FE3FF, #6F8BFF, s); B = mix(#9A7BFF, #B46BFF, s)   (cyan -> violet with load)","field.render":"A = #5CFFD8, B = #7F8CFF (mint -> periwinkle while a render runs; load still shifts B toward #B46BFF by s*0.5)","field.hot":"h = clamp((temp_c - 75) / 5, 0, 1); A = mix(base.A, #FFB257, h); B = mix(base.B, #FF4F6A, h); at temp_c >= temp_red_c (83): A = #FF7A45, B = #FF3355. The hot state itself starts at temp_c >= temp_amber_c (80).","field.sleepy":"A = #7A88DD, B = #3D3F95 (dim indigo)","mixing":"linear in sRGB is fine at these sizes; during transitions mix the two states' fields and alphas by the frame's t"},"edge":{"what":"Rendering progress line, drawn live by code each poll (never in the atlas).","units":"design units (px = (u + 8) * scale in the cell)","hexagon":{"centre":[60,62],"circumradius":42,"orientation":"pointy top; vertex i at angle (60*i - 90) degrees, i = 0 top, clockwise on screen","vertices":[[60,20],[96.373,41],[96.373,83],[60,104],[23.627,83],[23.627,41]]},"corners":"each corner is a quadratic Bezier: from the point 10 u before the vertex along the incoming edge, control point = the vertex, to the point 10 u after it along the outgoing edge (corner cut 10 u, same shape as the body outline)","path_d":"M51.340 25.000 Q60.000 20.000 68.660 25.000 L87.713 36.000 Q96.373 41.000 96.373 51.000 L96.373 73.000 Q96.373 83.000 87.713 88.000 L68.660 99.000 Q60.000 104.000 51.340 99.000 L32.287 88.000 Q23.627 83.000 23.627 73.000 L23.627 51.000 Q23.627 41.000 32.287 36.000Z","segments":[{"type":"quad","p0":[51.34,25],"ctrl":[60,20],"p1":[68.66,25],"length":18.24},{"type":"line","p0":[68.66,25],"p1":[87.713,36],"length":22},{"type":"quad","p0":[87.713,36],"ctrl":[96.373,41],"p1":[96.373,51],"length":18.24},{"type":"line","p0":[96.373,51],"p1":[96.373,73],"length":22},{"type":"quad","p0":[96.373,73],"ctrl":[96.373,83],"p1":[87.713,88],"length":18.24},{"type":"line","p0":[87.713,88],"p1":[68.66,99],"length":22},{"type":"quad","p0":[68.66,99],"ctrl":[60,104],"p1":[51.34,99],"length":18.24},{"type":"line","p0":[51.34,99],"p1":[32.287,88],"length":22},{"type":"quad","p0":[32.287,88],"ctrl":[23.627,83],"p1":[23.627,73],"length":18.24},{"type":"line","p0":[23.627,73],"p1":[23.627,51],"length":22},{"type":"quad","p0":[23.627,51],"ctrl":[23.627,41],"p1":[32.287,36],"length":18.24},{"type":"line","p0":[32.287,36],"p1":[51.34,25],"length":22}],"perimeter_u":241.437,"start":"segments[0].p0 (on edge V5->V0, 10 u left/below the top vertex); runs clockwise; draw the first progress * perimeter of the path","stroke":{"width_u":3.2,"cap":"round","join":"round","gradient":"linear, horizontal across the hexagon (x 23.63 -> 96.37 u): field.A -> #D8FF6A"},"glow":"gaussian blur sigma 1.6 u of the stroke; composite blur, blur, then the sharp stroke (alpha = min(1, 2 * blur + sharp)); this matches the eyes' glow","head":"optional: none (keep it clean); 100% closes the loop","redraw":"only when progress changes (once per poll, 1 Hz)"},"states":{"idle":{"loop":[{"hold":18,"halo":0,"eyes":"eyes_open"},{"hold":18,"halo":1,"eyes":"eyes_open","dy":-1}],"blink":{"every_ticks":[48,84],"frames":[{"hold":1,"eyes":"eyes_blink_half"},{"hold":1,"eyes":"eyes_blink_closed"},{"hold":1,"eyes":"eyes_blink_half"}],"note":"overlay on the current breath frame"}},"render":{"loop":[{"hold":6,"halo":0,"eyes":"eyes_focus","sparkle":0},{"hold":6,"halo":0,"eyes":"eyes_focus","sparkle":1},{"hold":6,"halo":1,"eyes":"eyes_focus","sparkle":0,"dy":-1},{"hold":6,"halo":1,"eyes":"eyes_focus","sparkle":1,"dy":-1}],"edge":true},"hot":{"loop":[{"hold":4,"halo":0,"eyes":"eyes_hot","steam":0},{"hold":4,"halo":0,"eyes":"eyes_hot","steam":1},{"hold":4,"halo":1,"eyes":"eyes_hot","steam":2,"dy":-1}]},"sleepy":{"loop":[{"hold":24,"halo":0,"eyes":"eyes_sleepy_0","z":0,"rot":9},{"hold":24,"halo":1,"eyes":"eyes_sleepy_1","z":1,"rot":9,"dy":1}]}},"transitions":{"idle>render":[{"hold":2,"eyes":"eyes_focus_t1","t":0.33},{"hold":2,"eyes":"eyes_focus_t2","t":0.67}],"render>idle":[{"hold":2,"eyes":"eyes_focus_t2","t":0.33},{"hold":2,"eyes":"eyes_focus_t1","t":0.67}],"idle>hot":[{"hold":2,"eyes":"eyes_hot_t1","t":0.33},{"hold":2,"eyes":"eyes_hot_t2","t":0.67}],"hot>idle":[{"hold":2,"eyes":"eyes_hot_t2","t":0.33},{"hold":2,"eyes":"eyes_hot_t1","t":0.67}],"idle>sleepy":[{"hold":2,"eyes":"eyes_sleepy_t1","rot":4.5,"t":0.5},{"hold":2,"eyes":"eyes_sleepy_t2","rot":9,"t":1.0}],"sleepy>idle":[{"hold":2,"eyes":"eyes_sleepy_t2","rot":9,"t":0.0},{"hold":2,"eyes":"eyes_sleepy_t1","rot":4.5,"t":0.5}],"other_pairs":"go through idle without holding it, e.g. render>hot = render>idle frames then idle>hot frames","t":"colour/alpha mix factor from the source state's field (0) to the target's (1)"},"triggers":{"render":"a render job is active (same rule as the island)","hot":"temp_c >= gpu.temp_amber_c (80); leave below temp_amber_c - 2","sleepy":"gpu_load < 5% for 10 min and no render","priority":"hot > render > sleepy > idle"},"timing_rules":"Never run a constant 12 fps timer: after drawing a frame, arm a one-shot timer for hold * 83 ms. Steady idle redraws every 1.5 s, sleepy every 2 s, render every 0.5 s, hot every 0.33 s. Pause (no timer) while minimised, covered or a fullscreen app is in front; resume at frame 0 of the loop."}